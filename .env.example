# 输液余量监测系统 —— 环境变量样例
# 复制为 .env 后按院内实际填写。严禁把真实值提交到仓库。
# 服务启动时按名校验以下凭据位，缺项即启动失败并列出缺哪一个。

# ── M5 出站：护理执行平台（写回换液事件）────────────────────────
NURSE_EXEC_BASE_URL=https://nurse-exec.example-hospital.local
NURSE_EXEC_API_TOKEN=replace-me
WRITEBACK_TIMEOUT=5.0               # 出站单次请求超时（秒）
# 待写回队列：出站失败的欠账落盘（writeback_queue），到期自动重试；
# 关掉后台扫描后只剩人工重放一条路（GET /pending → POST /pending/{id}/replay）。
WRITEBACK_RETRY_ENABLED=true
WRITEBACK_RETRY_INTERVAL_SECONDS=5.0

# ── M5 入站：输液泵遥测（MQTT）──────────────────────────────────
# 遥测**只**用于与医嘱速率交叉校验。整条通道关掉（MQTT_ENABLED=false）时，
# 余量曲线、毫升换算与换液判定照常，只是 eta_source 恒为 order_text。
MQTT_HOST=mqtt.example-hospital.local
MQTT_PORT=1883
MQTT_USERNAME=infusion-monitor
MQTT_PASSWORD=replace-me
MQTT_TOPIC_PREFIX=hospital/infusion

# 断线重连：指数退避 1s → 2s → 4s …封顶 32s。0 表示一直重试（默认）——
# 病区 broker 停机会被信息科当独立故障处理，本服务不替它放弃订阅。
# 「连稳」MQTT_RECONNECT_RESET_SECONDS 之后才把退避清零：broker 抖动时若每次
# 都清零，会退化成「连上→掉→1 秒后又连上」的固定频率重试。
MQTT_RECONNECT_BASE_SECONDS=1.0
MQTT_RECONNECT_FACTOR=2.0
MQTT_RECONNECT_MAX_SECONDS=32.0
MQTT_RECONNECT_MAX_ATTEMPTS=0
MQTT_RECONNECT_RESET_SECONDS=300.0
# 遥测新鲜窗口：拍摄时刻与这条泵速读数相差超过它，响应里报 telemetry_state=stale。
# **新鲜度不参与门禁**：stale 的读数照样用于一致性交叉校验，只是状态如实报出来。
TELEMETRY_FRESH_SECONDS=300.0

# ── M6 模型网关（OpenAI-compatible，院内自建端点或本地模型）──────
LLM_BASE_URL=https://llm-gateway.example-hospital.local/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_TIMEOUT=8.0

# ── M2 预测器实现（确定性几何核 / 生产权重）─────────────────────
# 换实现只改 MODEL_IMPL / MODEL_ID 两个变量，业务代码不动。
# 解析顺序：注册表（core/config_map.py）→ 本节四项的覆盖 → MODEL_REGISTRY_JSON。
# 权重缺失**不会**静默退回几何核，而是启动即报错并点名缺哪个变量（见 INSTALL.md）。
MODEL_IMPL=geom_kernel           # geom_kernel（本机默认，无权重）| weights（生产权重）
MODEL_ID=geom_kernel_base        # geom_kernel_base / geom_kernel_low_light /
                                 # weights_base / weights_base_plus / weights_large
MODEL_CONFIG_PATH=               # 留空 = 用注册表登记的配置文件；填了却不存在则启动即报错
MODEL_CHECKPOINT=                # 留空 = 用注册表登记的权重（仅 weights 实现需要）
MODEL_REGISTRY_ROOT=./models     # 配置与权重的相对路径按该根目录解析（病区侧机默认挂载点）
# MODEL_REGISTRY_JSON=            # 按 model_id 覆盖/追加注册表（院内多环境切换）。示例：
#   {"weights_pilot": {"impl": "weights", "config": "weights_pilot.yaml",
#                      "checkpoint": "weights_pilot.pt", "requires_checkpoint": true}}

# ── M6 网关护栏 ────────────────────────────────────────────────
LLM_DAILY_CALL_LIMIT=2000
LLM_MAX_TOKENS_PER_REQUEST=1200

# ── M6 决策融合仲裁（gateway/fusion.py）────────────────────────
# 模型在本产品里只贡献「给护士看的那句话」：结论与触发原因码永远由确定性阈值
# 路径给出，只有两者一致且置信达门禁时才采信模型措辞，冲突/越界/低置信一律回落。
# 院内还没部署端点就保持 LLM_FUSION_ENABLED=false——关掉不影响任何结论。
LLM_FUSION_ENABLED=false
LLM_FUSION_CONFIDENCE_FLOOR=0.60

# ── M4 存储 ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./var/infusion_monitor.db
FRAMES_ROOT=./var/frames              # 会话帧目录根；分片续传的暂存目录在它下面的 _staging/

# ── M4 保留期与归档（store/retention.py）──────────────────────
# 到点的帧目录由 scripts/purge_expired_sessions.py 清理（cron）。
# 清的是像素：面积比曲线、毫升数、ETA、换液结论都留在会话行里。
# 会话还没结束、或换液事件还没送达对端的，帧目录一个都不动。
RETENTION_SESSION_DAYS=30.0           # 帧目录保留天数；覆盖一次月度质控复盘与换袋争议追溯
RETENTION_INFERENCE_AUDIT_DAYS=90.0   # 模型调用元数据的保留天数（审计链是飞检留档，不清）
RETENTION_ARCHIVE_ROOT=               # 归档根目录；留空=到期直接删除，配了就按月分目录搬过去

# ── M4 分片续传与半成品清理（ingest/resume.py）──────────────────
# 网络不稳时开着没提交的那一段帧会留在 _staging 下，到期由
# POST /api/v1/infusion/uploads/cleanup（或 scripts/purge_partial_uploads.py）回收。
UPLOAD_RESUME_RETENTION_HOURS=24.0    # 保留多久；一轮巡视 1–2 小时，24 小时足够当天补传
UPLOAD_RESUME_MAX_PENDING=50          # 未提交的分片上传数上限；终端断网反复重开会撞到这里

# ── 换液判定参数 ───────────────────────────────────────────────
CHANGE_FILL_RATIO_THRESHOLD=0.12
CHANGE_CONSECUTIVE_FRAMES=5
CHANGE_MIN_INTERVAL_MINUTES=15
CHANGE_MAX_PICKS_PER_ROUND=3

# ── M2 面积序列平滑（core/smoothing.py）────────────────────────
# 体积与 ETA 都吃这条曲线，参数配错就是「还早着呢」被误报成「快见底了」。
SMOOTHING_MEDIAN_WINDOW=5          # 中值窗口（观测点计）：5 才能吃掉连着两帧的镜面高光
SMOOTHING_ALPHA=0.6                # 一阶平滑中新观测的权重；压太小会让换液点名迟到
SMOOTHING_RISE_TOLERANCE=0.004     # 单帧允许的面积比上升量，超过即判反常帧
SMOOTHING_SPIKE_TOLERANCE=0.02     # 原始值与中值偏离超过此值标尖峰
SMOOTHING_MIN_GAP_FRAMES=2         # 缺帧少于此数不做受限重建（留 null）
SMOOTHING_MAX_GAP_FRAMES=10        # 受限重建的最大缺帧数；不得小于 MIN

# ── M1 一轮巡视的规模控制（ingest/resize.py）─────────────────────────
# 一轮巡视最坏 1200 帧、原生长边动辄 4000px。这一组决定它在病区服务器上怎么才算
# 跑得动：长边缩到上限、短边不许缩到硬校验线以下、只把输液架那块 ROI 喂给预测器。
# 三项都只影响算力与画面范围，**不改变面积比/余量/ETA**（都是比例量）。
FRAME_RESIZE_ENABLED=true         # 是否在解包落盘时缩放；关掉则原样处理
FRAME_LONG_EDGE_MAX=1280          # 长边上限（px）：形态学核是固定像素尺度的，再大只更慢
FRAME_SHORT_EDGE_FLOOR=320        # 短边下限（px）：不得低于 320（ingest/validate.py 的硬校验）
ROI_ENABLED=true                  # 是否按首帧候选框把预测器限制在输液架那块画面
ROI_MARGIN_RATIO=0.12             # 窗口相对候选框向外放多少（长边比例）；液面下降要留余量
ROI_MAX_STEP_RATIO=0.05           # 单次窗口边缘最多移动多少（长边比例）：防抖，也防场景突变
ROI_ALPHA=0.35                    # 窗口指数平滑系数（新观测的权重）
ROI_MIN_SIDE=96                   # 窗口短边下限（px）；比这更小没有分辨力，宁可不开窗
UPLOAD_MAX_BYTES=167772160        # 单次整段上传字节上限（默认 160MB）；超限 413 并指路分片续传
UPLOAD_MAX_SECONDS=120.0          # 单次整段上传接收时限（秒）；超限 408 并指路分片续传

# ── M1/M2 拍摄质量：上传前预检（ingest/quality.py）+ 袋级分类（core/failure_modes.py）──
# 两层质检共用下面这一组门限与同一张中文文案表，不会出现「预检说好、袋级说坏」。
# 只影响「要不要建议补拍」，不影响曲线与毫升数；配太紧会让护士被提示条淹没。
QUALITY_SAMPLE_FRAMES=5            # 每段均匀采样几帧做质检（与短片长度无关，恒定算力）
QUALITY_MIN_HIT_RATIO=0.34         # 至少这个比例的采样帧命中才算这段有问题（抗单帧误判）
QUALITY_GLARE_RATIO_THRESHOLD=0.0015  # 近白像素占比超此值判反光过曝
QUALITY_LOW_LIGHT_MEAN_LUMA=46.0   # 全画面平均灰度低于此值判暗光
QUALITY_SHARPNESS_MIN=150.0        # 拉普拉斯方差下限，低于此值判运动模糊
QUALITY_TILT_ANGLE_DEG=8.0         # 液面线倾角超此值判角度不正
QUALITY_DRIP_TAIL_RATIO=0.55       # 腔体底部窄带填充率低于此值判滴斗空管（info 级）
MODEL_SATURATION_MIN=96            # 液体饱和度下限；几何核与预检共用，保证两层量的是同一批液体
PRECHECK_MIN_SHORT_SIDE=480        # 上传前预检的短边「质量」下限；硬下限仍是 320（低于它 422）
PRECHECK_DEGRADED_SCORE=0.70       # 五项子分加权平均低于此值即标 degraded，即便一类都没命中

# ── M3 标定版本偏差闸门（calibration/versions.py）────────────
# 改版后同一袋的新旧毫升读数相对差超过此值，**不自动覆盖**旧读数：差这么大量
# 多半是新版本自己有问题。旧读数保留 + 挂待复核 + 落告警，等护理部结案才生效。
CALIBRATION_REVIEW_DEVIATION=0.15   # 0.15 = 差 15% 就要复核；调到 0 等于不设闸门

# ── M3 体积不确定度与置信门禁（calibration/uncertainty.py）────────
# 毫升数要可信才敢拿去点名换液。置信度低于门禁时 estimated_volume_ml **不出数**
# （响应里字段整体不出现），护士端改按 volume_uncertainty 显示区间与补做提示。
# 门限等价于「相对不确定度 > 0.14」；该值由 灵敏度 × 面积比噪声 ÷ 毫升数 算出，
# 所以低液位天然更严——调这几项时先想清楚是想让哪一档液位能出数。
UNCERTAINTY_MIN_CONFIDENCE=0.60          # 放行所需最低置信度；1.0 等于永远不出数
UNCERTAINTY_HIGH_OCCLUSION_RATIO=0.35    # 遮挡帧占比超此值判 high_occlusion（等挡开重拍）
UNCERTAINTY_SIGMA_FILL_FLOOR=0.010       # 面积比噪声地板；合成回归实测最差拍法 0.0120
UNCERTAINTY_GEOMETRY_MODEL_SIGMA=0.030   # 腔体几何换算自身的相对误差（登记精度）
UNCERTAINTY_OCCLUSION_GAIN=0.20          # 遮挡占比换算成相对不确定度的增益
UNCERTAINTY_SIGMA_CEILING=0.35           # 置信度归零的相对不确定度（与最低置信度合成门限）

# ── MQTT webhook 兜底通道（可选）───────────────────────────────
# 给**病区没有 MQTT broker、或病区侧没有订阅权限**的院区用：输液泵网关把泵速
# POST 到 /api/v1/infusion/telemetry/webhook/{rack_id}。两条通道共用同一份解析、
# 同一套去重、同一个缓存——同一条遥测从两条路各进来一次会被去重表认出来。
# 未配这一项就**没有这个端点**（404 webhook_disabled），不会拿默认密钥把它开着。
# 签名：HMAC-SHA256(密钥, "{ts}." + 请求体)，写作 sha256=<hex> 放 X-Infusion-Signature；
# 带 X-Infusion-Timestamp 时一并校验重放窗口——时间戳在签名串里，换掉就失效。
WEBHOOK_SIGNING_SECRET=replace-me
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300.0   # 重放窗口；对端时钟不准会自己拒掉自己的真消息，先对时
WEBHOOK_MAX_BODY_BYTES=65536                 # 一条遥测几十字节；超限 413，不落盘也不解析